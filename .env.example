# ==========================================================
# AgroConnect Academy — configuration (copier en .env)
# Toute la configuration passe par ce fichier. Ne jamais publier le .env.
# ==========================================================

# --- Application ---
APP_URL=http://localhost:3000
APP_NAME=AgroConnect Academy
# Secret de signature des sessions : 64 caractères aléatoires au moins en production.
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=remplacer-par-une-longue-chaine-aleatoire
SESSION_DAYS=30
# Autoriser les apprenants à créer un compte eux-mêmes (true ou false)
ALLOW_REGISTRATION=true

# --- Base de données MySQL (8.0 ou plus, ou MariaDB 10.6 ou plus) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=academy
DB_PASSWORD=remplacer-par-le-mot-de-passe
DB_NAME=agroconnect_academy
DB_CONNECTION_LIMIT=10
# Connexion chiffrée vers la base (true si la base est sur un autre serveur)
DB_SSL=false

# --- Contenus ---
# Dossier des 18 fichiers de formation (relatif à la racine du projet)
CONTENT_DIR=content

# --- Limites de fréquence (par heure) ---
RATE_ATTEMPTS_USER=20
RATE_ATTEMPTS_ANON=120
RATE_ACTIVITY_USER=300
RATE_ACTIVITY_ANON=900
RATE_LOGIN=10

# --- Premier administrateur (utilisé par : npm run admin:create) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrateur

# --- Paiement CinetPay (lot N2, non utilisé dans ce lot) ---
CINETPAY_APIKEY=
CINETPAY_SITE_ID=

# --- Publicité (lot N3, non utilisée dans ce lot) ---
ADS_ENABLED=false
